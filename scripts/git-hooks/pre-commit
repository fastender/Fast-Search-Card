#!/usr/bin/env bash
# Pre-commit hook — runs the five source guards before allowing the commit:
#   check-extraction-debt.py         DUPLICATE + UNUSED IMPORT regressions
#   check-i18n-keys.py               missing dictionary keys / German text in en.js
#   check-purgecss-dynamic.py        class names PurgeCSS would drop
#   check-einstellungs-register.mjs  settings without an entry in the search register
#   check-tastatur.mjs               silent framer-motion tab stops / rows without keyboard / unnamed buttons
# (Auftrag 09 added the i18n guard; before, only the other two ran.)
#
# Install once:   bash scripts/install-git-hooks.sh
# Disable:        git config --unset core.hooksPath
# Skip one time:  git commit --no-verify
#
# We do NOT run check-hooks.sh here — its current bash implementation takes
# ~11 s on this codebase (330 files × multi-awk + per-builtin grep). Run it
# manually after big refactors or before pushing:
#   bash scripts/check-hooks.sh

set -e

ROOT="$(git rev-parse --show-toplevel)"
SRC="$ROOT/src"

# src/ is gitignored in this project — it always exists locally but isn't
# part of the staged set. Skip the check if src/ doesn't exist (e.g. fresh
# worktree without the source).
if [ ! -d "$SRC" ]; then
  exit 0
fi

if ! python3 "$ROOT/scripts/check-extraction-debt.py" -q "$SRC"; then
  echo ""
  echo "❌ Pre-commit: extraction-debt check failed."
  echo "   Run for details:   python3 scripts/check-extraction-debt.py src"
  echo "   Skip this commit:  git commit --no-verify"
  exit 1
fi

# Auftrag 09 (2026-09-13): i18n-Wächter — jeder translateUI('…')-Schlüssel muss in
# de.js UND en.js stehen (ein fehlender Schlüssel kommt als PFAD zurück, also als
# truthy Text auf dem Schirm), und en.js darf keinen deutschen Text tragen.
# Laufzeit gemessen ~0,7 s — keine eigene Schnellvariante nötig.
if ! python3 "$ROOT/scripts/check-i18n-keys.py" > /dev/null 2>&1; then
  echo ""
  echo "❌ Pre-commit: i18n-Wächter — fehlende Schlüssel oder deutscher Text in en.js."
  echo "   Run for details:   python3 scripts/check-i18n-keys.py"
  echo "   Skip this commit:  git commit --no-verify"
  exit 1
fi

# v1.1.2346: PurgeCSS-Wächter — Klassennamen, die nur ZUSAMMENGESETZT vorkommen
# (`foo-${x}`), verlieren ihre CSS-Regeln im Release-Build (v1.1.2226 bento,
# v1.1.2344 Feed-Hülle). Das Skript rechnet PurgeCSS' Entscheidung nach; ~0.5 s.
if ! python3 "$ROOT/scripts/check-purgecss-dynamic.py" > /dev/null 2>&1; then
  echo ""
  echo "❌ Pre-commit: PurgeCSS-Wächter — zusammengesetzte Klassennamen würden im Build verloren gehen."
  echo "   Run for details:   python3 scripts/check-purgecss-dynamic.py"
  echo "   Skip this commit:  git commit --no-verify"
  exit 1
fi

# v1.1.2419 (Roadmap #46): Register-Wächter der Einstellungs-Suche — jede
# Beschriftung der Einstellungen braucht einen Register-Eintrag, sonst findet die
# Suche sie nicht. Lädt Register + Wörterbücher in Node; ~0,2 s.
if ! node --no-warnings "$ROOT/scripts/check-einstellungs-register.mjs" -q > /dev/null 2>&1; then
  echo ""
  echo "❌ Pre-commit: Register-Wächter — Einstellung ohne Eintrag im Such-Register."
  echo "   Run for details:   node scripts/check-einstellungs-register.mjs"
  echo "   Skip this commit:  git commit --no-verify"
  exit 1
fi

# v1.1.2422: Tastatur-Wächter — framer-motion macht jedes motion-Element mit
# whileTap/onTap ohne tabindex selbst zum stummen Tab-Stopp (Enter klickt dort
# nicht), und jede ios-item-clickable-Zeile braucht Tastatur an der Zeile oder
# an einem Teil; seit v1.1.2423 braucht jeder Knopf einen Namen. Syntaxbaum über
# @babel/parser; ~0,7 s.
if ! node --no-warnings "$ROOT/scripts/check-tastatur.mjs" -q > /dev/null 2>&1; then
  echo ""
  echo "❌ Pre-commit: Tastatur-Wächter — stummer Tab-Stopp, Zeile ohne Tastatur oder Knopf ohne Namen."
  echo "   Run for details:   node scripts/check-tastatur.mjs"
  echo "   Skip this commit:  git commit --no-verify"
  exit 1
fi

echo "✓ Pre-commit: extraction-debt, i18n, purgecss, einstellungs-register, tastatur — alle fünf Wächter grün"
exit 0
